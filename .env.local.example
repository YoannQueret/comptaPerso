# Example environment variables for running comptaPerso without Docker
# (`python run.py`). Copy this file to `.env.local`, fill in your own values,
# then load it before starting the app:
#
#   cp .env.local.example .env.local
#   source .env.local && python run.py
#
# `.env.local` is meant to hold your real secrets locally — don't commit it.
# Every line here matches a variable documented in README.md; uncomment and
# adjust only the ones you need, everything else falls back to its default.

# --- Core ---
# export SECRET_KEY=change-me-in-production
# export ALLOW_REGISTRATION=true
# export PORT=5000
# export FLASK_DEBUG=false

# --- Database ---
# export DB_ENGINE=sqlite
# export DATA_DIR=./data
# MariaDB (only used when DB_ENGINE=mariadb):
# export DB_HOST=db
# export DB_PORT=3306
# export DB_USER=compta
# export DB_PASSWORD=compta
# export DB_NAME=comptaperso

# --- Startup / backups ---
# export SKIP_DB_UPGRADE=false
# export BACKUP_DIR=./data/backups
# export BACKUP_KEEP=20

# --- Attachments ---
# export ATTACHMENTS_DIR=./data/attachments

# --- Outgoing email (password reset) ---
# export SMTP_HOST=smtp.example.com
# export SMTP_PORT=587
# export SMTP_USERNAME=you@example.com
# export SMTP_PASSWORD=your-smtp-password
# export SMTP_USE_TLS=true
# export SMTP_USE_SSL=false
# export MAIL_FROM=no-reply@example.com
# export PASSWORD_RESET_TOKEN_MAX_AGE=3600
